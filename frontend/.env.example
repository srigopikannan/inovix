# ROADGUARD AI - Frontend Environment Configuration

# MapTiler Satellite API Key
# Sign up and get your free or enterprise API key at: https://cloud.maptiler.com/
# If left empty, ROADGUARD AI will automatically use high-resolution ESRI World Imagery satellite tiles as a fallback.
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# Google Maps JavaScript & Street View API Key
# Required for interactive 360° Google Street View panoramas.
# Enable "Maps JavaScript API" in Google Cloud Console.
# Restrict the key by HTTP referrers (e.g., http://localhost:5173/* or your production domain).
# If omitted, ROADGUARD AI will honestly display: "Street View imagery is not available for this location."
# and provide verified ground optical inspection survey frames where available.
VITE_GOOGLE_MAPS_API_KEY=
